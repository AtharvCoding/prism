.DS_Store
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Data is never committed. The snapshot MANIFEST.json is the reproducibility
# record (spec §4.1); the parquet files themselves are reproduced from it.
data/raw/
data/interim/
data/processed/
data/holdout/
!data/**/MANIFEST.json

# Generated outputs. reports/ is regenerated by scripts/07_report.py.
reports/figures/*
reports/tables/*
reports/logs/*
!reports/**/.gitkeep

# Model artefacts
*.pt
*.pkl
*.joblib
